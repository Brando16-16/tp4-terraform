resource "aws_security_group" "sg_<###ITEM_NAME###>" {
  name        = "${var.project_name}-sg-<###ITEM_NAME###>"
  description = "SG pour le Reverse Proxy"
  vpc_id      = <###PARAM_1###>

  ingress {
    description = "HTTP depuis Internet"
    from_port   = <###PARAM_4###>
    to_port     = <###PARAM_4###>
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  ingress {
    description = "HTTPS depuis Internet"
    from_port   = <###PARAM_5###>
    to_port     = <###PARAM_5###>
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  ingress {
    description     = "SSH uniquement depuis le Bastion Host"
    from_port       = <###PARAM_6###>
    to_port         = <###PARAM_6###>
    protocol        = "tcp"
    security_groups = [<###PARAM_2###>]
  }

  egress {
    description     = "HTTP applicatif uniquement vers le Serveur Web"
    from_port       = <###PARAM_7###>
    to_port         = <###PARAM_7###>
    protocol        = "tcp"
    security_groups = [<###PARAM_3###>]
  }

  tags = {
    Name = "${var.project_name}-sg-<###ITEM_NAME###>"
  }
}